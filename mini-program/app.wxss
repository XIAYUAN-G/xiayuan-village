page {
  background: #f5efdf;
  color: #3c4b3d;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

button::after { border: 0; }

.page-shell {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 5% 4%, rgba(166,181,117,.22), transparent 360rpx),
    radial-gradient(circle at 100% 18%, rgba(196,162,102,.17), transparent 380rpx),
    #f5efdf;
}

.top-kicker {
  display: inline-block;
  padding: 6rpx 18rpx;
  border: 1rpx solid rgba(255,235,177,.42);
  border-radius: 999rpx;
  color: #f6e5ac;
  background: rgba(15,45,28,.28);
  font-size: 21rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.hero {
  margin: -28rpx -28rpx 26rpx;
  padding: 44rpx 34rpx 40rpx;
  color: #fff7da;
  text-align: center;
  background: linear-gradient(135deg, rgba(37,70,48,.97), rgba(82,112,72,.94));
  box-shadow: 0 6rpx 22rpx rgba(42,65,40,.16);
}

.hero-title {
  margin: 18rpx 0 10rpx;
  color: #fff0bc;
  font-size: 56rpx;
  font-weight: 900;
  line-height: 1.25;
  letter-spacing: 2rpx;
}

.hero-desc {
  margin: 0 auto;
  max-width: 660rpx;
  color: rgba(255,253,247,.82);
  font-size: 26rpx;
  line-height: 1.65;
}

.panel {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(116,137,94,.24);
  border-radius: 24rpx;
  background: rgba(255,253,243,.94);
  box-shadow: 0 8rpx 24rpx rgba(64,78,51,.08);
}

.panel-title {
  margin: 0 0 10rpx;
  color: #2f513d;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.4;
}

.panel-desc {
  margin: 0;
  color: #687666;
  font-size: 25rpx;
  line-height: 1.7;
}

.mascot-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 260rpx;
  height: 260rpx;
  margin: 28rpx auto 30rpx;
  border-radius: 48% 52% 50% 46%;
  background: linear-gradient(145deg, #e4edc7, #c8d9a6);
  box-shadow: inset 0 -12rpx 0 rgba(78,107,61,.12);
  transform: rotate(3deg);
}

.sprite {
  width: 230rpx;
  height: 230rpx;
  background-image: url("./assets/xmu-sidebar-monsters-sheet-expressive-v3-transparent.png");
  background-repeat: no-repeat;
  background-size: 400% 400%;
}

.hero-sprite { width: 220rpx; height: 220rpx; }

.primary-btn,
.secondary-btn {
  display: block;
  width: 100%;
  margin: 18rpx 0 0;
  padding: 18rpx 24rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.4;
}

.primary-btn { color: #fff8dc; background: #2f513d; }
.secondary-btn { color: #2f513d; background: #eef3df; }

.mini-note {
  margin: 18rpx 0 0;
  color: #89917e;
  font-size: 21rpx;
  line-height: 1.55;
  text-align: center;
}

.quiz-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
  color: #69825a;
  font-size: 23rpx;
  font-weight: 800;
}

.progress {
  height: 12rpx;
  overflow: hidden;
  border-radius: 99rpx;
  background: #e7ead8;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #cc765d, #c89443);
}

.question-kicker {
  display: inline-block;
  margin: 26rpx 0 12rpx;
  padding: 6rpx 14rpx;
  border-radius: 99rpx;
  color: #8a6734;
  background: #f7edce;
  font-size: 21rpx;
  font-weight: 800;
}

.question-title {
  margin: 0;
  color: #203e2d;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.5;
}

.option {
  display: block;
  width: 100%;
  min-height: 98rpx;
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(122,145,94,.22);
  border-radius: 18rpx;
  color: #3c4b3d;
  background: #f7faea;
  font-size: 26rpx;
  line-height: 1.45;
  text-align: left;
}

.option-letter {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  color: #fff;
  background: #77945b;
  font-size: 22rpx;
  font-weight: 900;
  vertical-align: middle;
}

.quiz-actions {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 24rpx;
}

.text-btn {
  padding: 8rpx 0;
  border: 0;
  color: #6d8062;
  background: transparent;
  font-size: 22rpx;
}

.result-head { text-align: center; }
.result-badge { color: #fff9df; background: #cc765d; }
.result-title { margin: 14rpx 0 6rpx; color: #203e2d; font-size: 48rpx; font-weight: 900; }
.result-tagline { margin: 0; color: #67805a; font-size: 26rpx; font-weight: 800; }

.result-box {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-left: 8rpx solid #cc765d;
  border-radius: 12rpx;
  color: #6d5944;
  background: #fff5df;
  font-size: 24rpx;
  line-height: 1.65;
  text-align: left;
}

.result-box.mission { border-left-color: #77945b; color: #526850; background: #edf3de; }
.result-box-label { font-weight: 900; }

.tag-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 22rpx; }
.tag { padding: 6rpx 14rpx; border-radius: 99rpx; color: #5b734f; background: #e8f0d5; font-size: 21rpx; }

.footer-note {
  padding: 12rpx 20rpx 0;
  color: #89917e;
  font-size: 21rpx;
  line-height: 1.6;
  text-align: center;
}

.empty-icon { margin: 18rpx 0; font-size: 72rpx; text-align: center; }
.empty-title { color: #2f513d; font-size: 38rpx; font-weight: 900; text-align: center; }
.empty-desc { margin: 12rpx 0 0; color: #6d7869; font-size: 25rpx; line-height: 1.7; text-align: center; }
