[Unit]
Description=Xiayuan Guide web service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/xiayuan
Environment=PORT=8080
EnvironmentFile=-/etc/xiayuan.env
ExecStart=/usr/bin/python3 /opt/xiayuan/server.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
