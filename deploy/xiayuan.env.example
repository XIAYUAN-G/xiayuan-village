# AI 服务
SILICONFLOW_API_KEY=你的硅基流动密钥
SILICONFLOW_MODEL=Qwen/Qwen3-8B

# 资料管理员
MATERIAL_ADMIN_USERNAME=admin
# 推荐使用：python3 server.py --make-password-hash 生成，不要把明文密码写入网页
MATERIAL_ADMIN_PASSWORD_HASH=pbkdf2$sha256$310000$盐$salt后接Base64哈希
MATERIAL_ADMIN_SESSION_TTL=43200
MATERIAL_MAX_BYTES=52428800

# 资料存储：部署到腾讯云 COS 时填写 cos；本地测试可填 local
MATERIAL_STORAGE=cos
COS_BUCKET=你的存储桶名称-APPID
COS_REGION=ap-guangzhou
COS_SECRET_ID=最小权限子账号SecretId
COS_SECRET_KEY=最小权限子账号SecretKey
# 如果使用临时密钥，再填写 COS_SESSION_TOKEN
COS_SESSION_TOKEN=
